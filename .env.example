# 运行配置
ZHIYU_DATA_DIR=~/.zhiyu
ZHIYU_LOG_LEVEL=INFO
# ZHIYU_DATABASE_URL=sqlite:////absolute/path/to/companion.db
# ZHIYU_SKILLS_DIR=~/.zhiyu/skills

# API Key：复制本文件为 .env 后填入，zhiyu 启动时自动加载。
# 用法：uv run zhiyu provider add deepseek --type deepseek --api-key-env DEEPSEEK_API_KEY
# 也可以不填这里，改用交互式 provider add 写入系统钥匙串。
DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# KIMI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
