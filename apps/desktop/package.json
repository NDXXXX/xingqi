{
  "name": "desktop",
  "version": "0.1.0",
  "description": "Desktop AI Companion",
  "author": "Desktop AI Companion",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "build:backend": "cd ../server && uv run pyinstaller --noconfirm companion-server.spec",
    "dist:mac": "npm run build:backend && npm run build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.desktop-ai-companion.app",
    "productName": "Desktop AI Companion",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist/companion-server",
        "to": "backend"
      },
      {
        "from": "../../skills",
        "to": "skills"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
